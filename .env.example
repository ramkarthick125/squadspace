# ==============================================================================
# SQUADSPACE ENVIRONMENT CONFIGURATION (100% FREE TIER)
# ==============================================================================

# Supabase (Free Tier: https://supabase.com)
# 500 MB DB, 1 GB Storage, 200 Realtime concurrent connections, 50k MAU
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# LiveKit Cloud (Free Build Tier: https://livekit.io)
# 5,000 participant minutes/month, 50 GB bandwidth, hard cap (no surprise billing)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_LIVEKIT_TOKEN_ENDPOINT=https://your-project-id.supabase.co/functions/v1/livekit-token

# Optional: Tenor GIF Search API (100% Free: https://developers.google.com/tenor)
VITE_TENOR_API_KEY=
